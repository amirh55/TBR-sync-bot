# TBR Sync Bot configuration.
# Copy to .env and fill in, or just run: python3 setup_env.py
# Every key also accepts its UPPERCASE form (BALE_TOKEN, TELEGRAM_TOKEN, ...).

# ----------------------------------------------------------------- required
bale_token=
telegram_token=
# Source channel on Bale. Use @name for a public channel or the numeric id.
bale_channel_id=@your_bale_channel
# Destination channel on Telegram. The bot must be an admin there.
telegram_channel_id=@your_telegram_channel

# ----------------------------------------------------------------- optional

# Prefix every line with a right-to-left mark. Helps mixed Persian/English text.
force_rtl=false

# Process posts that piled up while the bot was offline.
# The bot now remembers its position across restarts, so this only matters
# on a very first run or after the state database is deleted.
sync_old_messages=false

# Largest file to forward, in MB. Telegram bots cannot upload more than 50MB,
# so anything above this is skipped with a note instead of failing the post.
max_file_mb=45

# Message appended when files were skipped. {count} is replaced with the number.
# Leave empty to stay silent about skipped files.
skipped_file_notice=⚠️ {count} فایل به دلیل محدودیت حجم تلگرام ارسال نشد.

# Rewrite a channel handle when copying text across.
bale_username_to_replace=
telegram_username_replacement=

# --------------------------------------------------------------- networking

# Long-poll timeout in seconds, and how many updates to fetch per call.
poll_timeout=25
poll_limit=100

# How long to wait for the rest of an album before sending it as one group.
media_group_wait_seconds=1.2

# How many times to retry a Telegram call on flood control or a network blip.
telegram_max_retries=5

# ------------------------------------------------------------------ storage

# Where the bale->telegram message map and the update offset are kept.
state_db=.tbr_sync.db
# Scratch directory for media in transit; files are deleted after sending.
temp_dir=temp_downloads

# ---------------------------------------------------------------- debugging

# Log the media fields of every incoming Bale post.
debug_media=false
# Log posts that arrived from a chat other than the configured source.
log_ignored_updates=false
# Append the raw JSON of unsupported posts to a file (may contain personal data).
log_unsupported_json=false
unsupported_log=unsupported_updates.log
# Send a placeholder message instead of silently skipping unsupported posts.
fallback_send_unsupported_as_text=false

# Bale sometimes sends the same image as both `photo` and `document`.
# Keeping this on avoids posting it twice.
skip_duplicate_media_documents=true
